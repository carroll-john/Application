{
  "name": "application-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-supabase-env": "node ./scripts/sync-supabase-env.mjs",
    "verify-resend": "node ./scripts/verify-resend.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eligibility-contract": "vitest run api/evaluate-transcript-eligibility.test.ts src/lib/eligibility/transcriptFixtures.test.ts src/lib/eligibility/client.test.ts src/lib/eligibility/normalize.test.ts src/lib/eligibility/deterministicRules.test.ts src/lib/eligibility/uiCopy.test.ts",
    "test:cv-parser": "node ./scripts/cv-parser-regression.mjs",
    "dev:cv-parser-api": "tsx ./scripts/dev-cv-parser-server.mjs",
    "supabase:types": "supabase gen types typescript --project-id \"$(cat supabase/.temp/project-ref)\" --schema public > src/lib/supabase.types.ts",
    "start-task": "bash ./scripts/start-task.sh",
    "finish-task": "bash ./scripts/finish-task.sh",
    "notion:publish-note": "node ./scripts/publish-stakeholder-note-to-notion.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.42.0",
    "@sentry/react": "^10.40.0",
    "@supabase/supabase-js": "^2.98.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.1.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "node-fetch": "^2.7.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  }
}
