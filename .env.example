# Google Maps key is only required on suggest-service (GOOGLE_MAPS_API_KEY), not in the browser.
SUGGEST_SERVICE_URL=https://suggest-service-sm3b.onrender.com
SUGGEST_SERVICE_TOKEN=your_suggest_service_token
VITE_POSTHOG_KEY=your_posthog_project_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Authorises synthetic end-to-end QA traffic (a bot) to bypass the analytics
# bot-filter. Leave UNSET in normal production. When set, a session that loads
# the app with ?kp_synthetic=<this-value> is captured and every event is tagged
# synthetic_test:true so it can be excluded from real metrics. Use a long random
# value and set it only on the preview/QA deployment you point the bot at.
# VITE_ANALYTICS_SYNTHETIC_TOKEN=
POSTHOG_PROJECT_API_KEY=your_posthog_project_key
POSTHOG_HOST=https://eu.i.posthog.com
VITE_LOCAL_CV_PARSER_URL=http://127.0.0.1:4190/api/parse-cv
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# UC assessment MVP isolation. The demo references are verification-only and
# must not be configured as runtime endpoints or credentials.
SUPABASE_URL=https://your_uc_mvp_project.supabase.co
SUPABASE_ANON_KEY=your_uc_mvp_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_uc_mvp_service_role_key
UC_MVP_SUPABASE_PROJECT_REF=your_uc_mvp_project
UC_DEMO_SUPABASE_PROJECT_REF=verification_only_demo_project_ref
UC_MVP_POSTHOG_PROJECT_ID=your_uc_mvp_posthog_project_id
UC_DEMO_POSTHOG_PROJECT_ID=verification_only_demo_posthog_project_id
UC_MVP_ELIGIBILITY_DEPLOYMENT_ID=your_uc_mvp_staging_deployment_id
UC_DEMO_ELIGIBILITY_DEPLOYMENT_ID=verification_only_demo_deployment_id
UC_MVP_SUPABASE_URL=https://your_uc_mvp_project.supabase.co
UC_MVP_SUPABASE_SERVICE_ROLE_KEY=your_uc_mvp_service_role_key
UC_PILOT_ALLOCATION_SALT=your_long_random_pilot_allocation_salt
UC_PILOT_INVITATION_BASE_URL=https://your-generated-mvp-preview.vercel.app
UC_ASSESSMENT_TREATMENT_ENABLED=false
UC_ASSESSMENT_APPROVED_RULES_VERSION=
ASSESSMENT_MALWARE_SCANNER_URL=https://your-private-scanner.example/scan
ASSESSMENT_MALWARE_SCANNER_TOKEN=your_private_scanner_token
VITE_APP_BRAND=uc
VITE_DEMO_MODE=false
# Resend (hosted auth email via Supabase custom SMTP — not used by the Vite app directly)
RESEND_API_KEY=your_resend_api_key
VITE_REMOTE_UPLOAD_MAX_FILES_PER_APPLICATION=30
VITE_REMOTE_UPLOAD_MAX_TOTAL_BYTES_PER_APPLICATION=104857600
VITE_REMOTE_UPLOAD_RATE_LIMIT_WINDOW_MINUTES=10
VITE_REMOTE_UPLOAD_RATE_LIMIT_MAX_UPLOADS=20
OPENAI_API_KEY=your_openai_api_key
# Alternative for the isolated Vercel project. VERCEL_OIDC_TOKEN is injected by
# Vercel and refreshed locally by `vercel env pull`; never commit either token.
AI_GATEWAY_API_KEY=
OPENAI_CV_PARSER_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPT_ELIGIBILITY_MODEL=gpt-4.1-mini
# External eligibility service (github.com/carroll-john/eligibility-service).
# Leave ELIGIBILITY_SERVICE_URL unset to use the local OpenAI fallback. Contract: docs/contracts/eligibility-evaluate.v1.md
ELIGIBILITY_SERVICE_URL=https://eligibility-service.example.com/api/evaluate
ELIGIBILITY_SERVICE_TOKEN=your_eligibility_service_token
SENTRY_ENABLED=true
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=uc-assessment-mvp
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AGENT_NAME=cv-parser-employment-agent
SENTRY_AI_RECORD_INPUTS=false
SENTRY_AI_RECORD_OUTPUTS=false
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_ENVIRONMENT=uc-assessment-mvp
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_RELEASE=optional_release_name
