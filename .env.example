VITE_CLARITY_PROJECT_ID=your_clarity_project_id
# Google Maps key is only required on suggest-service (GOOGLE_MAPS_API_KEY), not in the browser.
SUGGEST_SERVICE_URL=https://suggest-service-sm3b.onrender.com
SUGGEST_SERVICE_TOKEN=your_suggest_service_token
VITE_POSTHOG_KEY=your_posthog_project_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_API_KEY=your_posthog_project_key
POSTHOG_HOST=https://eu.i.posthog.com
VITE_LOCAL_CV_PARSER_URL=http://127.0.0.1:4190/api/parse-cv
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Resend (hosted auth email via Supabase custom SMTP — not used by the Vite app directly)
RESEND_API_KEY=your_resend_api_key
VITE_REMOTE_UPLOAD_MAX_FILES_PER_APPLICATION=30
VITE_REMOTE_UPLOAD_MAX_TOTAL_BYTES_PER_APPLICATION=104857600
VITE_REMOTE_UPLOAD_RATE_LIMIT_WINDOW_MINUTES=10
VITE_REMOTE_UPLOAD_RATE_LIMIT_MAX_UPLOADS=20
OPENAI_API_KEY=your_openai_api_key
OPENAI_CV_PARSER_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPT_ELIGIBILITY_MODEL=gpt-4.1-mini
# External eligibility service (github.com/carroll-john/eligibility-service).
# Leave ELIGIBILITY_SERVICE_URL unset to use the local OpenAI fallback. Contract: docs/contracts/eligibility-evaluate.v1.md
ELIGIBILITY_SERVICE_URL=https://eligibility-service.example.com/api/evaluate
ELIGIBILITY_SERVICE_TOKEN=your_eligibility_service_token
SENTRY_ENABLED=true
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=preview
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AGENT_NAME=cv-parser-employment-agent
SENTRY_AI_RECORD_INPUTS=false
SENTRY_AI_RECORD_OUTPUTS=false
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_ENVIRONMENT=preview
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
SENTRY_RELEASE=optional_release_name
